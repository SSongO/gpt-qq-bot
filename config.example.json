    "wsUrl": "ws://127.0.0.1:3001",
    "httpUrl": "http://127.0.0.1:3000",
    "accessToken": "",
    "eventSecret": "",
    "botQQ": ""
  },
  "access": {
    "ownerQQ": "",
    "privateUsers": [],
    "groups": [],
    "blockedUsers": [],
