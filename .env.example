# Optional: copy this file to .env and put your own key here.
# This takes priority over the key saved from the local console.
OPENAI_API_KEY=

# Optional local HTTP proxy, supported by the bundled Node.js 24.22.1.
# Use the HTTP proxy port from your own proxy app; do not copy an unrelated port.
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://127.0.0.1:YOUR_HTTP_PROXY_PORT
# HTTP_PROXY=http://127.0.0.1:YOUR_HTTP_PROXY_PORT
# NO_PROXY=localhost,127.0.0.1,::1
